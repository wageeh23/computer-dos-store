{
  "name": "computer-parts-store",
  "version": "1.0.0",
  "description": "برنامج إدارة محل قطع كمبيوتر وإكسسوارات - بيع وشراء ومخزون",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "electron": "electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "electron-builder --dir",
    "gen:icons": "node scripts/gen-icons.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "express": "^4.21.2",
    "framer-motion": "14.7.1",
    "gsap": "3.15.0",
    "vite-plugin-pwa": "2.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.computerparts.store",
    "productName": "Computer DOS Store",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Computer DOS Store"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
